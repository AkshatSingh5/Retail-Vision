# Copy to .env and fill in local values. Do not commit secrets.

DATABASE_URL=sqlite:///./retail_vision.db

# YOLO26m — detection / crop only. Official Ultralytics asset: yolo26m.pt
YOLO_MODEL_PATH=vision/models/yolo26m.pt
YOLO_DEVICE=cuda
YOLO_CONFIDENCE_THRESHOLD=0.50
# Scan path uses a lower gate so branded packs are not dropped before DINOv2.
DETECT_CONFIDENCE=0.15

# DINOv2 — visual embeddings / product identity
DINO_DEVICE=cuda
DINOV2_MODEL=facebook/dinov2-small
DINO_SIMILARITY_THRESHOLD=0.82
PRODUCT_MATCH_MARGIN=0.04
PRELOAD_YOLO=true
PRELOAD_DINOV2=true

# --- Vercel dashboard (do not commit secrets) ---
# Vercel sets VERCEL=1 automatically. The app then uses CPU and skips model preload.
# Use a hosted Postgres URL in production (Neon / Vercel Postgres / Supabase).
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require
# YOLO_DEVICE=cpu
# DINO_DEVICE=cpu
# PRELOAD_YOLO=false
# PRELOAD_DINOV2=false
# PRELOAD_FLORENCE=false
# STORAGE_BACKEND=local
