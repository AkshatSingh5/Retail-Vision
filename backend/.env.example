# Copy to backend/.env or the repo-root .env. Do not put real credentials here.

# PostgreSQL (local or cloud). Do not assume localhost in production.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# CORS — production Vercel origin (no trailing slash)
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
# Optional extra origins, comma-separated
# CORS_ORIGINS=https://www.example.com
# Preview deployments (*.vercel.app) are allowed by default. Set to off to disable.
# CORS_ORIGIN_REGEX=off

YOLO_MODEL_PATH=vision/models/yolo26m.pt
MODEL_PATH=vision/models/yolo26m.pt

YOLO_DEVICE=cuda
DINO_DEVICE=cuda

YOLO_CONFIDENCE_THRESHOLD=0.50
DETECT_CONFIDENCE=0.15

EMBEDDING_BACKEND=dinov2
DINOV2_MODEL=facebook/dinov2-small
EMBEDDING_DIM=384

PRELOAD_YOLO=true
PRELOAD_DINOV2=true

FLORENCE_MODEL=microsoft/Florence-2-base
PRELOAD_FLORENCE=false

DINO_SIMILARITY_THRESHOLD=0.82
PRODUCT_MATCH_THRESHOLD=0.82
PRODUCT_MATCH_MARGIN=0.04

DUPLICATE_MATCH_THRESHOLD=0.93

SCAN_MATCH_THRESHOLD=0.82
SCAN_MATCH_MARGIN=0.04

GALLERY_MATCH_THRESHOLD=0.86

RECOGNITION_DEBUG=false
SCAN_DEBUG_CROPS=false

MIN_IMAGE_SIDE=64
BLUR_VARIANCE_MIN=45

STORAGE_BACKEND=local

S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_PREFIX=products
