# Vercel Environment Variables
# Import this file in Vercel: Project → Settings → Environment Variables
# Apply to Production, Preview, and Development.
#
# Vercel does not install PyTorch / YOLO / DINOv2 / OpenCV. Scan uses Pillow
# decode plus color embeddings and a center-crop fallback. For GPU detection,
# run the API on a machine with `pip install -r requirements.txt` (or `uv sync --extra ml`).
#
# Do not put real passwords or AWS keys in this file if you commit it.
# Vercel already sets VERCEL=1 — do not add that yourself.

# --- Database ---
# SQLite is ephemeral on Vercel (lives under /tmp, resets on cold start).
# For a real catalog, replace with Neon / Vercel Postgres / Supabase:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=sqlite:///./retail_vision.db

# --- Store ---
STORE_NAME=Retail Vision
STORE_ADDRESS=AI Checkout Counter
DISCOUNT_PERCENT=0

# --- Devices (Vercel has no GPU; config.py also forces CPU when VERCEL=1) ---
YOLO_DEVICE=cpu
DINO_DEVICE=cpu
PRELOAD_YOLO=false
PRELOAD_DINOV2=false
PRELOAD_FLORENCE=false

# --- Vision ---
YOLO_MODEL_PATH=vision/models/yolo26m.pt
YOLO_CONFIDENCE_THRESHOLD=0.50
DETECT_CONFIDENCE=0.15
IOU_THRESHOLD=0.45
EMBEDDING_BACKEND=color
DINOV2_MODEL=facebook/dinov2-small
EMBEDDING_DIM=384
DINO_SIMILARITY_THRESHOLD=0.82
PRODUCT_MATCH_THRESHOLD=0.82
PRODUCT_MATCH_MARGIN=0.04
DUPLICATE_MATCH_THRESHOLD=0.93
GALLERY_MATCH_THRESHOLD=0.86

# --- Tracking / camera (no webcam on Vercel) ---
CAMERA_INDEX=0
STABLE_FRAMES=5
TRACK_MAX_MISSING=20
TRACK_IOU_THRESHOLD=0.30
TRACKER=bytetrack
ENABLE_EMBEDDING_REFINEMENT=false
AUTO_DETECT_ON_CAMERA=false

# --- Storage (local = /tmp on Vercel; use s3 for lasting product images) ---
STORAGE_BACKEND=local
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PREFIX=products

# --- Debug ---
RECOGNITION_DEBUG=false
SCAN_DEBUG_CROPS=false
